#include <scenesrg_all.srgi>
#include <viewsrg_all.srgi>

#include <Atom/RPI/Math.azsli>
#include <Atom/Features/ScreenSpace/ScreenSpaceUtil.azsli>

#include "CloudscapeCommon.azsli"

ShaderResourceGroup PassSrg : SRG_PerPass
{
    // A number from 0 .. 15. Defines the pixel index
    // within each 2x2 block that will be ray marched in this frame. 
    uint m_pixelIndex4x4;

    // Used to scale world position XYZ when sampling
    // the Noise Textures during ray marching.
    float m_uvwScale; // = 0.25;

    // Number of mip levels available in the low frequency
    // texture. The low frequency texture is assumed to be larger
    // than the high frequency noise texture.
    // typically the low freq texture is 128,128,128
    // and the high freq is 32,32,32.
    // When sampling the high frequency texture we subtract 2
    // from the mip level chosen when sampling the low freq texture. 
    uint m_maxMipLevels;

    // The Ray Marching Steps impact performance greatly.
    // See the following results from an NVIDIA 4090 RTX @2560x1440:
    // For 6 light integration steps:
    // Min Steps 64, Max Steps 96, 529,408ns
    // Min Steps 64, Max Steps 96, 524,288ns
    // Min Steps 48, Max Steps 96, 520,192ns - No visual degradation
    // Min Steps 48, Max Steps 96, 512,000ns - No Visual degradation
    // Min Steps 32, Max Steps 64, 397,312ns - No Visual degradation
    // Min Steps 32, Max Steps 64, 388,096ns - No Visual degradation
    // Min Steps 24, Max Steps 48, 316,416ns - No Visual degradation
    // Min Steps 24, Max Steps 48, 314,368ns - No Visual degradation
    // Min Steps 16, Max Steps 32, 238,592ns - tiny bit of banding at long distance
    // Min Steps 16, Max Steps 32, 249,856ns - tiny bit of banding at long distance
    // Min Steps  8, Max Steps 16, 166,912ns - little bit of banding starting at mid distance
    // Min Steps  8, Max Steps 16, 162,816ns - little bit of banding starting at mid distance 
    // Minimum number of ray marching steps used to calculate transmittance.
    // For practical purposes should never be less than 8.
    // Value 24 gives decent results.
    uint m_minRayMarchingSteps;
    // Maximum number of ray marching steps used to calculate transmittance.
    // For practical purposes should never be more than than 128.
    // Value 48 gives decent results.
    uint m_maxRayMarchingSteps;

    // Planetary data
    [[pad_to(16)]]
    float m_planetRadiusKm;// = 6371;
    float m_cloudSlabDistanceAboveSeaLevelKm;// = 1.5;
    float m_cloudSlabThicknessKm;// = 3.5;

    [[pad_to(16)]]
    float4 m_sunColorAndIntensity; //rgb is color. alpha is intensity factor.
    float4 m_ambientLightColorAndIntensity; //rgb is color. alpha is intensity factor.
    // Direction towards the sun is expected to be normalized.
    float3 m_directionTowardsTheSun;

    [[pad_to(16)]]
    // NOTE: Beer's Law Attenuation Coefficient = Absorption + Scattering coefficients.
    // Attenuation coefficient is typically 0.04[m-1] for clouds.
    // For clouds, Scattering coeffcient is typically 3x Absorption coeffcient.
    // Beer's Law Absorption coefficient. in units [Km-1] == [1/Km].
    // Typically it is in units of [m-1], but we use Km in all calculations
    // in this shader. 
    // Absortion coefficient, for clouds, is typically 0.01[m-1] == 10[Km-1]
    float m_aCoef;// = 200;
    // Beer's Law Scattering coeffcient. in units [Km-1] == [1/Km].
    // Typically it is in units of [m-1], but we use Km in all calculations
    // in this shader. 
    // For clouds it is typically 3x(Absorption coefficient) 0.03[m-1] == 30[Km-1]
    float m_sCoef;// = 3.0 * m_aCoef;
    // Excentricity constant in HenyeyGreenstein phase function. Typically 0.2.
    // A number between [-1,1]. The bigger it is the more forward scattering.
    float m_henyeyGreensteinG;// = 0.2; 
    // Эксцентриситет и вес обратного лепестка двухлепестковой фазы.
    float m_phaseBackLobeG;
    float m_phaseBackLobeWeight;

    // These are the a, b, c coefficients that will be used
    // to modulate each multi scaterring octave of light contribution
    // as proposed in the paper "Oz: The Great and Volumetric"
    // http://magnuswrenninge.com/wp-content/uploads/2010/03/Wrenninge-OzTheGreatAndVolumetric.pdf
    // a: Attenuation that affects the optical depth in Beer's Law evaluation.
    // b: Contribution to the scattering coefficient.
    // c: Excentricity Attenuation to the excentricity constant "g" (see @m_henyeyGreensteinG above).
    [[pad_to(16)]]
    float3 m_multipleScatteringABC;

    // Weather Data modulators
    [[pad_to(16)]]
    float m_weatherMapSizeKm;// = 60;
    // 1 - карта погоды задана, 0 - вместо неё белая текстура.
    float m_weatherMapInfluence;
    float m_windSpeedKmPerSec; // Km/sec
    float3 m_windDirection;
    // Pushes the top of the clouds along the wind direction by this
    // distance. Useful for dramatic/artistic effects.
    float m_cloudTopOffsetKm;
    // Во сколько раз сужен переход плотности на краю облака.
    float m_cloudEdgeSharpness;

    // Слои типов облаков. Layer: x - основание, y - толщина (доли толщины
    // слоя облаков), z - покрытие (0 - слой выключен), w - плотность.
    // Shape: x - разброс вершин, y - амплитуда рельефа основания (доля
    // толщины слоя облаков), z - рельеф основания 0..1.
    [[pad_to(16)]]
    float4 m_stratusLayer;
    float4 m_stratusShape;
    float4 m_stratocumulusLayer;
    float4 m_stratocumulusShape;
    float4 m_cumulusLayer;
    float4 m_cumulusShape;

    Texture2D<float2> m_depthStencilTexture;
    Sampler ClampPointSampler
    {
        MinFilter = Point;
        MagFilter = Point;
        MipFilter = Point;
        AddressU = Clamp;
        AddressV = Clamp;
        AddressW = Clamp;
    };

    Texture3D<float4> m_lowFreqNoiseTexture;
    Texture3D<float4> m_highFreqNoiseTexture;

    // Карта погоды. R: покрытие (0.5 - балл слоя), B: доля толщины слоя,
    // A: плотность (0.5 - плотность слоя).
    Texture2D<float4> m_weatherMap;
    Sampler WrapLinearSampler
    {
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
        AddressU = Wrap;
        AddressV = Wrap;
        AddressW = Wrap;
    };

    // We write to only one of these two textures every other frame.
    RWTexture2D<float4> m_cloudscapeOut[2];

    // Один сэмпл на блок 2x2 (CloudBlockSize).
    RWTexture2D<uint4> m_cloudTraceOut;

    uint GetOutputTextureIndex()
    {
        // FIXME: For now always texture 0 until we add reprojection pass.
        return 0;
    }

    //bool IsRayMarchedPixel(uint2 pixelLoc)
    //{
    //    // 1280 x 720
    //    // 1280 / 4 = 320
    //    // 720 / 4 = 180
//
    //    // 323 x 72
    //    // 323 / 4 = 80.75
    //    //    80 * 4 = 320. ModX = 3
    //    // 72 / 4 = 18
    //    //    18 * 4 = 72. ModY = 0
    //    // pixelIndex4x4 = ModY * 4 + ModX = 0 * 4 + 3 = 3
//
    //    // 323 x 74
    //    // 323 / 4 = 80.75
    //    //    80 * 4 = 320  . ModX = 3
    //    // 74 / 4 = 18.5
    //    //    18 * 4 = 72. ModY = 2
    //    // pixelIndex4x4 = ModY * 4 + ModX = 2 * 4 + 3 = 11
//
    //    //     320, 321, 322, 323
    //    //  72   0    1    2    3
    //    //  73   4    5    6    7
    //    //  74   8    9   10   11
    //    //  75  12   13   14   15  
//
    //    const uint blockX = pixelLoc.x >> 2;
    //    const uint modX = pixelLoc.x - (blockX * 4);
    //    const uint blockY = pixelLoc.y >> 2;
    //    const uint modY = pixelLoc.y - (blockY * 4);
//
    //    const uint pixelIndex4x4 = modY * 4 + modX;
    //    const uint transformedPixelIndex4x4 = GetTransformed4x4PixelIndex(m_pixelIndex4x4);
    //    
    //    return pixelIndex4x4 == transformedPixelIndex4x4;
    //}

    // This helper function calculates the corresponding
    // XY location within a 4x4 block of pixels.
    uint2 GetPixelBlockXY()
    {

        const uint pixelIndex4x4 = GetTransformed4x4PixelIndex(m_pixelIndex4x4);
        const uint rowIdx = pixelIndex4x4 >> 2;
        const uint colIdx = pixelIndex4x4 - (rowIdx << 2);
        return uint2(colIdx, rowIdx);
    }

    float3 GetScaledSunColor()
    {
        return m_sunColorAndIntensity.rgb * m_sunColorAndIntensity.a;
    }

    // Яркость неба, рассеянная в точку облака. Результат умножают на
    // коэффициент рассеяния, как свет солнца; тогда в толще облака
    // яркость стремится к яркости неба, а не к ambient / ослабление.
    // Основание видит тёмную землю и нижнюю часть облака, поэтому
    // получает треть яркости вершины. Цвет неба не умножают на цвет
    // солнца: тень облака голубая от неба, а не серая. Яркость следует
    // за яркостью солнца, иначе тень не меняется при смене экспозиции.
    float3 GetAmbientLightColor(float heightFraction)
    {
        static const float AmbientRadianceScale = 0.08;
        const float3 ambientColor = m_ambientLightColorAndIntensity.rgb
            * (m_ambientLightColorAndIntensity.a * m_sunColorAndIntensity.a * AmbientRadianceScale);
        return m_sCoef * lerp(ambientColor * 0.33, ambientColor, saturate(heightFraction));
    }

    float4 GetWeatherData(float3 worldPosKm)
    {
        const float halfWorldSizeKm = m_weatherMapSizeKm * 0.5;
        const float2 uv = float2(1.0 + (worldPosKm.x - halfWorldSizeKm) / m_weatherMapSizeKm,
                                 1.0 + (worldPosKm.y - halfWorldSizeKm) / m_weatherMapSizeKm);
        return PassSrg::m_weatherMap.SampleLevel(PassSrg::WrapLinearSampler, uv, 0);
    }

    // Returns a value between 0 and 1 of the height of the point within
    // the cloud slab thichness.
    float GetHeightFraction(float3 worldPosKm)
    {
        // This function assumes the center of the world is 0, 0, 0 (sphere center)
        const float innerSphereRadiusKm = m_planetRadiusKm + m_cloudSlabDistanceAboveSeaLevelKm;
        const float outerSphereRadiusKm = innerSphereRadiusKm + m_cloudSlabThicknessKm;
        return (length(worldPosKm /*- sphereCenter*/) - innerSphereRadiusKm) / (outerSphereRadiusKm - innerSphereRadiusKm);
    }

    // Returns a modified version of worldPosKm that considers wind effects.
    float3 ApplyWindEffect(float3 worldPosKm, float heightFraction)
    {
        // Skew in wind direction.
        worldPosKm += heightFraction * m_windDirection * m_cloudTopOffsetKm;
        
        // Animate clouds in wind direction with a small bias upwards.
        const float deltaTime = SceneSrg::m_time;// - SceneSrg::m_prevTime;
        const float3 windDirection = m_windDirection + float3(0, 0.0, 0.1);
        worldPosKm += windDirection * deltaTime * m_windSpeedKmPerSec;

        return worldPosKm;
    }

    // Should be called once per pixel.
    float CalcHenyeyGreenstein(float3 viewDirection, float g)
    {
        // Calculate henyeyGreenstein, which needs the cosine of the angle between the view and the
        // direction towards the sun light.
        const float cosAngle = dot(m_directionTowardsTheSun, viewDirection);
        const float g2 = g * g;
        #define INV_4PI (1.0/(4*3.141590))
        // FIXME/TODO: Do Schlick approximation.
        const float denom = 1 + g2 - 2 * g * cosAngle;
        // We are doing denom*denom*sqrt(denom) instead of pow(denom, 1.5)
        const float henyeyGreenstein = (1 - g2) / (denom * denom * sqrt(denom)) * INV_4PI;
        return  henyeyGreenstein;
    }


    // excentricityAttenuationOctave is the value of c^i, where i is the octave number 
    // as described in the multiscattering approximation per Magnus Wrenninge, et al in
    // the "Oz" paper (look for the link below).
    float CalcDualLobePhaseFunction(float3 viewDirection, float excentricityAttenuationOctave)
    {
        const float forwardPhase = CalcHenyeyGreenstein(viewDirection, excentricityAttenuationOctave * m_henyeyGreensteinG);
        const float backwardPhase = CalcHenyeyGreenstein(viewDirection, excentricityAttenuationOctave * m_phaseBackLobeG);
        return lerp(forwardPhase, backwardPhase, saturate(m_phaseBackLobeWeight));
    }
}


// Utility function that maps a value from one range to another.
// From GPU Pro 7. Chapter 4
static float Remap(float value, float oldMin, float oldMax, float newMin, float newMax)
{
    return (((value - oldMin) / (oldMax - oldMin)) * (newMax - newMin)) + newMin;
}


// Отсчёты шумов в точке, общие для всех типов облаков.
struct CloudNoiseSample
{
    float m_shape;
    float m_topNoise;
    // Шум клубов основания 0..1; 1 - клуб свисает до нижней границы слоя.
    float m_relief;
    float m_detailFBM;
    // Сила эрозии детальным шумом; 0, если детальный шум не берут.
    float m_detailStrength;
    float m_weatherHeight;
};

// Постоянные характера типа облака.
struct CloudTypeCharacter
{
    // Доля, на которую шум формы заменяют единицей: при большой доле
    // слой сплошной, с редкими разрывами.
    float m_noiseFlatten;
    // Доля высоты облака, с которой начинается спад формы к вершине.
    float m_topRampStart;
    // Степень спада к вершине: при большой степени облако держит ширину
    // почти до вершины (башня кучевого облака), при 2 сужается куполом.
    float m_topExponent;
    // Плотность у основания относительно плотности вершины.
    float m_baseDensity;
    // Шум пятен 0..1 и его вклад в покрытие: пятна разносят слои типов
    // по разным участкам неба.
    float m_patchNoise;
    float m_patchContrast;
    // Порог покрытия для доли неба под облаками 0, 0.05, 0.25, 0.5 (Lo)
    // и 0.75, 0.9, 1 (Hi). Доля неба от порога растёт по крутой
    // S-кривой; узлы сняты замером доли кадра под облаками при взгляде
    // сверху вниз.
    float4 m_coverageKnotsLo;
    float3 m_coverageKnotsHi;
};

// Порог покрытия, при котором облака закрывают долю неба @fraction.
float CoverageForFraction(float fraction, CloudTypeCharacter character)
{
    const float4 lo = character.m_coverageKnotsLo;
    const float3 hi = character.m_coverageKnotsHi;
    if (fraction < 0.05) return lerp(lo.x, lo.y, fraction / 0.05);
    if (fraction < 0.25) return lerp(lo.y, lo.z, (fraction - 0.05) / 0.2);
    if (fraction < 0.5) return lerp(lo.z, lo.w, (fraction - 0.25) / 0.25);
    if (fraction < 0.75) return lerp(lo.w, hi.x, (fraction - 0.5) / 0.25);
    if (fraction < 0.9) return lerp(hi.x, hi.y, (fraction - 0.75) / 0.15);
    return lerp(hi.y, hi.z, saturate((fraction - 0.9) / 0.1));
}

// @param layer x - основание, y - толщина, z - покрытие, w - плотность.
// @param shape x - разброс вершин, y - амплитуда рельефа основания,
//        z - рельеф основания 0..1.
float EvaluateCloudType(float heightFraction, float4 layer, float4 shape, CloudTypeCharacter character, CloudNoiseSample noise)
{
    const float base = layer.x;
    const float thickness = layer.y;
    if (layer.z <= 0.0 || heightFraction < base || heightFraction > base + thickness)
    {
        return 0.0;
    }

    // Клубы основания свисают вниз до основания слоя; между клубами
    // основание поднято на амплитуду рельефа. Так низ облака при подлёте
    // имеет вертикальный рельеф, а не плоский срез.
    const float baseLocal = base + shape.y * (1.0 - noise.m_relief);
    // Длинный подъём формы у основания вместе с порогом покрытия округляет
    // низ: где шум формы сильнее, облако опускается ниже.
    const float rampLength = thickness * lerp(0.04, 0.25, shape.z);
    const float topScale = lerp(1.0, lerp(0.25, 1.0, saturate(Remap(noise.m_topNoise, 0.3, 0.8, 0.0, 1.0))), shape.x);
    const float topLocal = max(base + thickness * noise.m_weatherHeight * topScale, baseLocal + rampLength + 0.01);
    const float bottomRamp = saturate((heightFraction - baseLocal) / rampLength);
    const float topRamp = saturate(Remap(heightFraction, lerp(baseLocal, topLocal, character.m_topRampStart), topLocal, 0.0, 1.0));
    const float shapeAltering = bottomRamp * (1.0 - pow(topRamp, character.m_topExponent));
    if (shapeAltering <= 0.0)
    {
        return 0.0;
    }

    // Шум пятен слабее при большом балле: при 8 октах разрывов в слое
    // нет. Карта погоды задаёт пятна полностью.
    const float cover = layer.z;
    const float patchContrast = lerp(character.m_patchContrast * (1.0 - cover * cover), 1.0, PassSrg::m_weatherMapInfluence);
    // Пятна меняют долю неба, а не порог: порог по доле растёт круто, и
    // пятно на пороге давало бы скачок от ясного неба к сплошному слою.
    const float fraction = saturate(cover * lerp(1.0, 2.0 * character.m_patchNoise, patchContrast));
    if (fraction <= 0.0)
    {
        return 0.0;
    }
    const float coverage = CoverageForFraction(fraction, character);
    const float shapeNoise = lerp(noise.m_shape, 1.0, character.m_noiseFlatten);
    float result = saturate(Remap(shapeNoise * shapeAltering, 1.0 - coverage, 1.0, 0.0, 1.0));

    // Высоту внутри облака считают от основания слоя, а не от клуба:
    // иначе профиль плотности рвётся на верхней границе рельефа.
    const float h = saturate((heightFraction - base) / max(topLocal - base, 1e-3));
    if (noise.m_detailStrength > 0.0)
    {
        // У основания эрозия сильнее: низ облака рыхлый, с клочьями.
        // Ближе к вершине деталь даёт клубы (Haggstrom 2018).
        const float baseFluff = 1.0 + 1.5 * shape.z * (1.0 - saturate(h * 4.0));
        const float erosion = noise.m_detailStrength * exp(-coverage * 0.75) * baseFluff * lerp(noise.m_detailFBM, 1.0 - noise.m_detailFBM, h);
        result = saturate(Remap(result, erosion, 1.0, 0.0, 1.0));
    }

    // Плотность после Remap растёт от края линейно по значению шума, а шум
    // меняется медленно: полупрозрачный край выходит шириной в сотни
    // метров. Множитель m_cloudEdgeSharpness сужает переход.
    const float densityProfile = lerp(character.m_baseDensity, 1.0, saturate(h * 2.0));
    return saturate(result * max(PassSrg::m_cloudEdgeSharpness, 1.0)) * densityProfile * layer.w;
}

// @param heightFraction A value between 0.0 and 1.0. 0.0 means that @worldPosKm is exactly touching the
//        inner sphere of the cloud slab, and 1.0 means that @worldPosKm is touching the outer sphere of the
//        cloud slab.
float SampleCloudDensity(float3 worldPosKm, float uvwScale, float mipLevel, float heightFraction, bool sampleHighFreqNoise)
{
    if (PassSrg::m_stratusLayer.z + PassSrg::m_stratocumulusLayer.z + PassSrg::m_cumulusLayer.z <= 0.0)
    {
        return 0.0;
    }

    worldPosKm = PassSrg::ApplyWindEffect(worldPosKm, heightFraction);

    // This is very important when sampling the Texture3D. Even though
    // we have a WRAP sampler, we should not use the @worldPosKm directly
    // because we endup sampling from very "distant" points within the Texture3D.
    // We need to normalize/scale the @worldPosKm into numbers closer to 0.0 and 1.0
    // for nicer/smoother sampling of the Texture3D.
    const float3 uvw = worldPosKm * uvwScale;

    const float4 lowFreqNoises = PassSrg::m_lowFreqNoiseTexture.SampleLevel(PassSrg::WrapLinearSampler, uvw, mipLevel);
    const float lowFreqFBM = lowFreqNoises.g * 0.625
                     + lowFreqNoises.b * 0.25
                     + lowFreqNoises.a * 0.125;

    // Без карты погоды берут нейтральные значения: покрытие и плотность
    // слоя без поправок, полная толщина слоя.
    float4 weatherData = float4(0.5, 0.5, 1.0, 0.5);
    if (PassSrg::m_weatherMapInfluence > 0.0)
    {
        weatherData = PassSrg::GetWeatherData(worldPosKm);
    }

    CloudNoiseSample noise;
    noise.m_shape = Remap(lowFreqNoises.r, lowFreqFBM - 1.0, 1.0, 0.0, 1.0);
    noise.m_weatherHeight = weatherData.b;

    // Вершины опускают по 2D шуму Уорли с ячейкой около 16 км: у соседних
    // облаков разная высота, и верх слоя не выглядит ровным срезом.
    static const float TopNoiseScalePerKm = 1.0 / 16.0;
    noise.m_topNoise = PassSrg::m_lowFreqNoiseTexture.SampleLevel(PassSrg::WrapLinearSampler,
        float3(worldPosKm.xy * TopNoiseScalePerKm, 0.37), 2.0).g;

    // Пятна типов облаков: 2D шум с ячейкой около 40 км, свой канал на
    // каждый тип.
    static const float PatchNoiseScalePerKm = 1.0 / 40.0;
    // Шум пятен - разность двух отсчётов одного шума: у разности среднее
    // ровно 0.5, и пятна не меняют средний балл слоя.
    const float2 patchUv = worldPosKm.xy * PatchNoiseScalePerKm;
    const float3 patchA = PassSrg::m_lowFreqNoiseTexture.SampleLevel(PassSrg::WrapLinearSampler, float3(patchUv, 0.71), 3.0).rbg;
    const float3 patchB = PassSrg::m_lowFreqNoiseTexture.SampleLevel(PassSrg::WrapLinearSampler, float3(patchUv + float2(0.37, 0.61), 0.29), 3.0).rbg;
    float3 patchNoise = saturate(0.5 + 1.5 * (patchA - patchB));
    patchNoise = lerp(patchNoise, weatherData.rrr, PassSrg::m_weatherMapInfluence);

    // Шум клубов основания берут только у оснований слоев и только для
    // полных отсчётов: выше основания он не влияет на форму, а отсчёты
    // света 6 на каждый шаг марша. Без шума основание
    // лежит на нижней границе слоя, и пропуск пустого воздуха не
    // проскакивает облако.
    noise.m_relief = 1.0;
    const bool nearBase = sampleHighFreqNoise && (
        (PassSrg::m_stratusLayer.z > 0.0 && heightFraction < PassSrg::m_stratusLayer.x + PassSrg::m_stratusShape.y + 0.25 * PassSrg::m_stratusLayer.y) ||
        (PassSrg::m_stratocumulusLayer.z > 0.0 && heightFraction < PassSrg::m_stratocumulusLayer.x + PassSrg::m_stratocumulusShape.y + 0.25 * PassSrg::m_stratocumulusLayer.y) ||
        (PassSrg::m_cumulusLayer.z > 0.0 && heightFraction < PassSrg::m_cumulusLayer.x + PassSrg::m_cumulusShape.y + 0.25 * PassSrg::m_cumulusLayer.y));
    if (nearBase)
    {
        // Частота в 1.5 раза выше формы даёт клубы шириной около километра.
        // Вклад FBM формы разносит высоту основания соседних облаков.
        static const float ReliefFrequencyScale = 1.5;
        const float reliefMipLevel = mipLevel + 1.6 * saturate(mipLevel);
        const float reliefWorley = PassSrg::m_lowFreqNoiseTexture.SampleLevel(PassSrg::WrapLinearSampler,
            uvw * ReliefFrequencyScale, reliefMipLevel).g;
        noise.m_relief = saturate((0.7 * reliefWorley + 0.3 * lowFreqFBM - 0.3) * 2.0);
    }

    noise.m_detailFBM = 0.0;
    noise.m_detailStrength = 0.0;
    if (sampleHighFreqNoise)
    {
        // FIXME: We sample "gba" instead of "rgba" because "r" channel contains perlin worley noise, and we only
        // need the worley noise.
        // Детальный шум берут с частотой в 3 раза выше формы и сдвигают
        // каналами низкочастотного шума: сдвиг заменяет curl-шум и ломает
        // повтор детали вдоль границы облака.
        static const float DetailFrequencyScale = 3.0;
        static const float DetailDistortion = 0.15;
        const float3 detailUvw = uvw * DetailFrequencyScale + (lowFreqNoises.gba - 0.5) * DetailDistortion;
        // Частота в 3 раза выше требует мип на log2(3) = 1.6 выше, иначе
        // вдали шум даёт зерно. Вблизи камеры мип 0 сохраняет деталь.
        const float detailMipLevel = mipLevel + 1.6 * saturate(mipLevel);
        const float3 highFreqNoise = PassSrg::m_highFreqNoiseTexture.SampleLevel(PassSrg::WrapLinearSampler, detailUvw, detailMipLevel).gba;
        noise.m_detailFBM = highFreqNoise.r * 0.625
                     + highFreqNoise.g * 0.25
                     + highFreqNoise.b * 0.125;
        // Per Haggstrom: The entire influence of the detail noise is reduced to be maximum 0.35,
        // with exp(−gc×0.75) the influence is reduced with the coverage (see EvaluateCloudType).
        // Деталь мельче пикселя на дальних облаках только шумит, поэтому
        // её влияние убывает до нуля к половине максимального мипа.
        const float detailFade = saturate(1.0 - mipLevel / max(0.5 * float(PassSrg::m_maxMipLevels - 1), 1.0));
        noise.m_detailStrength = detailFade * 0.35;
    }

    CloudTypeCharacter stratus;
    stratus.m_noiseFlatten = 0.6;
    stratus.m_topRampStart = 0.5;
    stratus.m_topExponent = 2.0;
    stratus.m_baseDensity = 0.8;
    stratus.m_patchNoise = patchNoise.x;
    stratus.m_patchContrast = 0.5;
    stratus.m_coverageKnotsLo = float4(0.12, 0.132, 0.146, 0.156);
    stratus.m_coverageKnotsHi = float3(0.1625, 0.1715, 0.2);

    CloudTypeCharacter stratocumulus;
    stratocumulus.m_noiseFlatten = 0.25;
    stratocumulus.m_topRampStart = 0.35;
    stratocumulus.m_topExponent = 2.0;
    stratocumulus.m_baseDensity = 0.5;
    stratocumulus.m_patchNoise = patchNoise.y;
    stratocumulus.m_patchContrast = 0.6;
    stratocumulus.m_coverageKnotsLo = float4(0.18, 0.2288, 0.2706, 0.2943);
    stratocumulus.m_coverageKnotsHi = float3(0.3172, 0.3394, 0.39);

    CloudTypeCharacter cumulus;
    cumulus.m_noiseFlatten = 0.0;
    cumulus.m_topRampStart = 0.45;
    cumulus.m_topExponent = 3.0;
    cumulus.m_baseDensity = 0.35;
    cumulus.m_patchNoise = patchNoise.z;
    cumulus.m_patchContrast = 0.4;
    cumulus.m_coverageKnotsLo = float4(0.27, 0.318, 0.3567, 0.3846);
    cumulus.m_coverageKnotsHi = float3(0.4132, 0.4388, 0.51);

    // Слои складывают по максимуму: в месте перекрытия слоев плотность
    // не удваивается.
    float density = EvaluateCloudType(heightFraction, PassSrg::m_stratusLayer, PassSrg::m_stratusShape, stratus, noise);
    density = max(density, EvaluateCloudType(heightFraction, PassSrg::m_stratocumulusLayer, PassSrg::m_stratocumulusShape, stratocumulus, noise));
    density = max(density, EvaluateCloudType(heightFraction, PassSrg::m_cumulusLayer, PassSrg::m_cumulusShape, cumulus, noise));

    return density * weatherData.a * 2.0;
}

// This function is based on three recommendations:
// 1- From "Oz: The Great and Volumetric"
//    http://magnuswrenninge.com/wp-content/uploads/2010/03/Wrenninge-OzTheGreatAndVolumetric.pdf
//    The suggestion is to simulate up to N octaves of in-scattered light.
// 2- From "Physically Based Sky, Atmosphere and Cloud Rendering in Frostbite"
//    https://media.contentapi.ea.com/content/dam/eacom/frostbite/files/s2016-pbs-frostbite-sky-clouds-new.pdf
//    a. The result of this function will be used in an energy-conserving integration function.
//    b. When ray matching towards the sun, we should sample in increasing step lengths.
// 3- From GPU Pro 7. Real-Time Voumetric Cloudscapes.
//    a. Use cone sampling of increasing radius.
//    b. Powder Sugar effect.
float3 GetMultiScatteredLuminance(float3 rayWorldPosKm, float stepSizeKm, float3 viewDirection)
{
    // REMARK: On an NVDIA 4090 RTX, at 2560x1440 resolution I benchmarked at different
    // light integration steps:
    // Steps 8. 546,816ns
    // Steps 8. 556,032ns
    // Steps 6. 497,664ns
    // Steps 6. 522,240ns
    // Steps 4. 517,120ns
    // Steps 4. 515,072ns
    // Steps 2. 473,088ns
    // Steps 2. 481,280ns
    // There's a perceivable quality between 6 and 4, but not between 6 and 8.
    // This define may be exposed as a shader option, but for a 4090 it wouldn't make much of a difference.
    #define NUM_LIGHT_SAMPLES (6)

    // Cone sampling random offsets.
    // Generated using the script VolumetricClouds/Gem/Editor/Scripts/cone_noise_kernel_gen.py
    // CAVEAT: This array would work with up to 12 light samples. Make sure NUM_LIGHT_SAMPLES is
    // less than 12.
    static const float3 NOISE_KERNEL[12] = {
        float3(0.82948634, -0.47047977, 0.30100033),
        float3(-0.63479043, -0.20974313, 0.74367259),
        float3(-0.84602539, -0.10106155, -0.52347646),
        float3(0.21666301, 0.86326400, 0.45588640),
        float3(0.08032086, 0.86948881, 0.48737847),
        float3(-0.81387245, -0.57331667, 0.09444381),
        float3(0.56074663, 0.63942210, 0.52602527),
        float3(-0.84755565, -0.10328429, -0.52055910),
        float3(-0.70260971, 0.70208185, -0.11584761),
        float3(0.45503186, 0.22278661, -0.86215551),
        float3(0.97105420, -0.16351118, -0.17412016),
        float3(-0.40700059, -0.25467177, -0.87720739),
    };

    float3 samplePosKm = rayWorldPosKm;
    float rayStepSizeKm = stepSizeKm;
    const float3 directionTowardsTheSun = PassSrg::m_directionTowardsTheSun;

	float opticalDepth = 0;
    const float eCoef = PassSrg::m_aCoef + PassSrg::m_sCoef;

	// Ray march towards the sun for STEP_COUNT steps, while sampling within a Cone shaped
    // volume.  
    int distanceMultipler = 1; //Makes sure we sample in increasing step length increments.
    float mipLevel = 0;
	for (int stepIdx = 0; stepIdx < NUM_LIGHT_SAMPLES; stepIdx++)
	{

        const float3 randomDirection = normalize(directionTowardsTheSun + NOISE_KERNEL[stepIdx] * 0.1);
        const float lightStepDistance = rayStepSizeKm * distanceMultipler;
		float3 posInConeKm = rayWorldPosKm + randomDirection * lightStepDistance;
        float heightFraction = PassSrg::GetHeightFraction(posInConeKm);
		if(heightFraction <= 1.00)
		{
            // Only if we are inside the cloud formation spherical slab, we'll do calculations. 
			// Always sample cheaply.
			float sampledCloudDensity = SampleCloudDensity(posInConeKm, PassSrg::m_uvwScale, mipLevel, heightFraction, false);// float(stepIdx + 1) LOD);
			if(sampledCloudDensity > 0)
			{
                opticalDepth += sampledCloudDensity * lightStepDistance * eCoef;
			}
		}

        distanceMultipler *= 2; // Doubling at each step makes a huge difference.
        mipLevel += 1.0;
	}

    const float3 sunColor = PassSrg::GetScaledSunColor();
    float3 luminance = 0.0;
    // In movies, per original "Oz" paper N (number of octaves) was used at value 8.
    // For games, 3 octaves should suffice.
    #define MAX_OCTAVES (3)
    const float3 abc = PassSrg::m_multipleScatteringABC;
    float3 powABC = float3(1, 1, 1);
    const float cosViewSun = dot(PassSrg::m_directionTowardsTheSun, viewDirection);
    const float powderWeight = 0.5 * saturate(0.5 - 0.5 * cosViewSun);
    for (int N = 0; N < MAX_OCTAVES; N++)
    {
        // Beer Law
        const float powA = powABC.x;
        const float attenuatedTransmittance = exp(-powA*opticalDepth);

        // Эффект powder (Schneider 2015): у края облака свет ещё не набрал
        // рассеяния внутрь, и край со стороны солнца темнее середины.
        // Против солнца эффект не виден, поэтому вес зависит от угла.
        const float powderFactor = 1.0 - exp(-2.0 * powA * opticalDepth);
        const float powderSugar = lerp(1.0, powderFactor, powderWeight);

        const float powB = powABC.y;
        const float scatteringContribution = PassSrg::m_sCoef * powB;

        const float powC = powABC.z;
        const float dualLobeHG = PassSrg::CalcDualLobePhaseFunction(viewDirection, powC);

        const float3 octaveLuminance = scatteringContribution * sunColor * dualLobeHG * (attenuatedTransmittance * powderSugar);
        luminance += octaveLuminance; 
        
        powABC *= abc;
    }

    // Свет, отражённый землёй, подсвечивает основание облака снизу.
    // Яркость земли по Ламберту: albedo * E * cos / pi; изотропная фаза
    // по нижней полусфере даёт половину этой яркости. Облако под точкой
    // ослабляет вклад линейно по высоте в слое.
    static const float GroundAlbedo = 0.1;
    const float3 upDirection = normalize(rayWorldPosKm);
    const float sunCosine = saturate(dot(upDirection, directionTowardsTheSun));
    const float heightFraction = saturate(PassSrg::GetHeightFraction(rayWorldPosKm));
    luminance += PassSrg::m_sCoef * sunColor * (0.5 * GroundAlbedo / 3.14159265 * sunCosine * (1.0 - heightFraction));

    return luminance;
}


struct AtmosphereIntersectionInfo
{
    // The starting position in world coordinates
    // where the view ray hits the Inner Sphere.
    float3 m_rayMarchStartPosKm;
    // Maximum distance that we should ray march starting at @m_rayMarchStartPosKm
    // and in the direction of @m_rayDirection.
    // Assuming there's no obstruction, this variable will be PassSrg::m_cloudSlabThicknessKm+
    // For example, when looking straight above then it will be PassSrg::m_cloudSlabThicknessKm, as We look
    // into the horizon this distance grows.
    float m_rayMarchDistanceKm;
    float3 m_rayDirection;
    // Distance from camera position in the direction of @m_rayDirection
    // that reaches the beginning of the cloud slab (inner sphere).
    float m_distanceFromCameraToInnerSphereKm;
};


// Возвращает оба корня пересечения луча со сферой с центром в начале координат
// (x <= y). При промахе возвращает (-1, -1).
float2 RaySphereHits(float3 rayOrigin, float3 rayDirection, float radius)
{
    const float b = dot(rayOrigin, rayDirection);
    const float c = dot(rayOrigin, rayOrigin) - radius * radius;
    const float discriminant = b * b - c;
    if (discriminant < 0.0)
    {
        return float2(-1.0, -1.0);
    }
    const float s = sqrt(discriminant);
    return float2(-b - s, -b + s);
}

// Облака лежат в сферическом слое между внутренней и внешней сферами.
// Камера самолёта бывает под слоем, внутри слоя и над ним, поэтому отрезок
// марша [tStart, tEnd] выбирают по высоте камеры. Отрезок обрезают глубиной
// сцены: облако между камерой и самолётом остаётся видимым, облако за
// самолётом и за землёй не рисуют.
bool GetCloudSlabIntersections(const float2 pixUV, inout AtmosphereIntersectionInfo intersectionResults, inout bool isCloudPixelBlocked)
{
    const float3 pixelPosWS = WorldPositionFromDepthBuffer(pixUV, 0.0).xyz;
    const float3 pixelViewVec = pixelPosWS - ViewSrg::m_worldPosition;
    const float distanceToPixel = length(pixelViewVec);
    const float3 rayDirection = pixelViewVec / distanceToPixel;

    float3 cameraPositionKm = ViewSrg::m_worldPosition * 0.001;
    cameraPositionKm.z += PassSrg::m_planetRadiusKm;

    const float innerRadiusKm = PassSrg::m_planetRadiusKm + PassSrg::m_cloudSlabDistanceAboveSeaLevelKm;
    const float outerRadiusKm = innerRadiusKm + PassSrg::m_cloudSlabThicknessKm;
    const float cameraRadiusKm = length(cameraPositionKm);

    const float2 innerHits = RaySphereHits(cameraPositionKm, rayDirection, innerRadiusKm);
    const float2 outerHits = RaySphereHits(cameraPositionKm, rayDirection, outerRadiusKm);
    const float2 planetHits = RaySphereHits(cameraPositionKm, rayDirection, PassSrg::m_planetRadiusKm);

    float tStart;
    float tEnd;
    if (cameraRadiusKm < innerRadiusKm)
    {
        tStart = innerHits.y;
        tEnd = outerHits.y;
        if (planetHits.x > 0.0)
        {
            // Луч уходит в землю раньше, чем достигает слоя.
            return false;
        }
    }
    else if (cameraRadiusKm <= outerRadiusKm)
    {
        tStart = 0.0;
        tEnd = (innerHits.x > 0.0) ? innerHits.x : outerHits.y;
    }
    else
    {
        if (outerHits.x <= 0.0)
        {
            return false;
        }
        tStart = outerHits.x;
        tEnd = (innerHits.x > 0.0) ? innerHits.x : outerHits.y;
    }

    // Глубиной сцены марш не обрезают: один пиксель марша представляет
    // блок 2x2, и край самолёта в блоке обрезал бы облака соседних пикселей.
    // Облако за геометрией отсекает растровый проход по передней глубине.
    isCloudPixelBlocked = false;
    if (tEnd <= tStart)
    {
        isCloudPixelBlocked = true;
        return false;
    }

    intersectionResults.m_rayMarchStartPosKm = cameraPositionKm + tStart * rayDirection;
    intersectionResults.m_rayMarchDistanceKm = tEnd - tStart;
    intersectionResults.m_rayDirection = rayDirection;
    intersectionResults.m_distanceFromCameraToInnerSphereKm = tStart;
    return true;
}


// @screenLocation is in pixels.
float GetJitterOffset(float2 screenLocation)
{
    // “interleaved gradient noise” by Jorge Jimenez
    const float3 magic = float3(0.067110560, 0.00583715, 52.9829189); 
    return -1.0 + 2.0 * frac(magic.z * frac( dot(screenLocation, magic.xy)));
}

// Some notes. This compute shader calculates RGB (cloud color) and A (opacity, based on transmittance).
// It assumes that the fragment shader will blend as: CloudRGB * One + RT (1 - cloudAlpha)
// cloudAlpha = (1 - Transmittance).
// This means that where there's no cloud, the CloudRGB must be (0,0,0) and cloudAlpha = 0.
// With low transmittance we'd have opaque clouds.
// With high transmittance we'd have transparent clouds and we'd see
// only the existing pixel color of the Render Target RT.
CloudTraceSample GetCloudColor(const float2 pixUV, const float2 pixLoc)
{
    // To avoid ghosting issues related with reprojection we will ray march the pixel
    // even if it is not visible. But we will ray march it with less steps.
    bool isCloudPixelBlocked = false;
    AtmosphereIntersectionInfo interInfo;
    CloudTraceSample result;
    result.m_color = 0.0;
    result.m_frontDepthKm = 1000.0;
    result.m_meanDepthKm = 1000.0;
    if (!GetCloudSlabIntersections(pixUV, interInfo, isCloudPixelBlocked))
    {
        return result;
    }

    // const bool wasCloudsPixelBlocked = PassSrg::m_prevFrameDepthTexture.SampleLevel(PassSrg::ClampPointSampler, pixUV, 0) != 0.0;
    // if (isCloudPixelBlocked && wasCloudsPixelBlocked)
    // {
    //     return 0.0;
    // }

    // We have now the ray marching data limits... start position, direction,
    // distance, etc.
    const float distanceToInnerSphereKm = interInfo.m_distanceFromCameraToInnerSphereKm;

    // Start the RayMarch
    const float rayMarchDistanceKm = interInfo.m_rayMarchDistanceKm;
    const float3 rayDirection = interInfo.m_rayDirection;

    // The minimum distance to raymarch inside the atmosphere is the atmosphere's thickness.
    // Throughout this thickness we will do minimum PassSrg::m_minRayMarchingSteps samples.
    // But when looking towards the horizon we'll ray march up to PassSrg::m_maxRayMarchingSteps samples.
    // Шаг растёт с расстоянием от камеры: вблизи самолёта шаг 25 м сохраняет
    // форму облака, вдали шаг стремится к равномерному шагу по числу сэмплов.
    const int minRayMarchingSteps = max((int)PassSrg::m_minRayMarchingSteps, 1);
    const int maxRayMarchingSteps = min((int)PassSrg::m_maxRayMarchingSteps, 128);
    const int numSamples = max(min((int)((minRayMarchingSteps * rayMarchDistanceKm) / PassSrg::m_cloudSlabThicknessKm), maxRayMarchingSteps), 1);
    const float farStepSizeKm = rayMarchDistanceKm / numSamples;
    const float nearStepSizeKm = min(0.025, farStepSizeKm);
    const float stepGrowthDistanceKm = 10.0;
    const int maxIterations = 320;

    // Длина шага к солнцу не зависит от шага взгляда: иначе облако вблизи
    // камеры получает короткий теневой луч и выглядит пересвеченным.
    // Шесть шагов с удвоением покрывают 63 базовых шага, то есть треть толщины слоя.
    const float lightStepSizeKm = PassSrg::m_cloudSlabThicknessKm / (3.0 * 63.0);

    // Сдвиг зависит от номера кадра: история усредняет разные позиции
    // сэмплов, и полосы от сдвига не застывают на экране.
    const float jitter = GetJitterOffset(pixLoc + 5.588238 * float(PassSrg::m_pixelIndex4x4)) * 0.5 + 0.5;
    float frontDepthKm = -1.0;
    float depthWeightedSumKm = 0.0;
    float depthWeightSum = 0.0;

    float3 totalColor = float3(0.0, 0.0, 0.0);
    float totalTransmittance = 1.0;

    const float eCoef = max(PassSrg::m_aCoef + PassSrg::m_sCoef, 0.00000001);

    // Мип шума выбирают по расстоянию до точки, а не по длине луча:
    // облако рядом с камерой всегда получает мип 0 и полную деталь.
    const float mipStartDistanceKm = 2.0;
    const float mipEndDistanceKm = 40.0;
    const float maxMip = max(float(PassSrg::m_maxMipLevels) - 1.0, 0.0);

    const float uvwScale = PassSrg::m_uvwScale;

    bool isEmptySpace = true;
    int zeroDensitySampleCount = 0;
    float t = 0.0;
    float prevT = 0.0;
    bool isFirstStep = true;

    for (int iteration = 0; iteration < maxIterations && t < rayMarchDistanceKm; iteration++)
    {
        const float distanceFromCameraKm = distanceToInnerSphereKm + t;
        const float growth = saturate(distanceFromCameraKm / stepGrowthDistanceKm);
        float stepSizeKm = lerp(nearStepSizeKm, farStepSizeKm, growth * growth);
        if (isEmptySpace)
        {
            // Луч вдоль слоя длиной 200-300 км получает шаг в несколько км и
            // пропускает вершины облаков размером 1-2 км. Попадание зависит
            // от сдвига старта, и у горизонта видно зерно. Шаг не больше
            // 4 % расстояния: размер шага на экране постоянный.
            stepSizeKm = min(stepSizeKm * 2.0, 0.05 + 0.04 * distanceFromCameraKm);
        }
        else
        {
            // При ослаблении 20-40 км^-1 шаг в километр гасит луч за один
            // сэмпл, и попадание по сдвигу старта меняется от кадра к кадру.
            // Внутри облака шаг растёт медленнее: 105 м на 10 км, 425 м на 50 км.
            stepSizeKm = min(stepSizeKm, 0.025 + 0.008 * distanceFromCameraKm);
        }

        // Первый шаг сдвинут шумом на долю шага: сдвиг убирает полосы от
        // одинаковых для всех пикселей позиций сэмплов.
        const float sampleT = isFirstStep ? t + jitter * stepSizeKm : t;
        isFirstStep = false;

        const float3 rayWorldPosKm = interInfo.m_rayMarchStartPosKm + rayDirection * sampleT;
        const float heightFraction = PassSrg::GetHeightFraction(rayWorldPosKm);
        const float mipLevel = saturate((distanceFromCameraKm - mipStartDistanceKm) / (mipEndDistanceKm - mipStartDistanceKm)) * maxMip;
        const float sampledCloudDensity = SampleCloudDensity(rayWorldPosKm, uvwScale, mipLevel, heightFraction, !isEmptySpace);

        if (sampledCloudDensity <= 0.0)
        {
            if (!isEmptySpace)
            {
                zeroDensitySampleCount++;
                if (zeroDensitySampleCount >= 6)
                {
                    isEmptySpace = true;
                }
            }
            prevT = t;
            t = sampleT + stepSizeKm;
            continue;
        }
        zeroDensitySampleCount = 0;

        // Плотность найдена крупным шагом: возврат на начало шага и переход
        // на мелкие шаги с высокочастотным шумом.
        if (isEmptySpace)
        {
            isEmptySpace = false;
            t = prevT;
            continue;
        }

        const float stepTransmittance = exp(-eCoef * sampledCloudDensity * stepSizeKm);
        const float3 luminance = GetMultiScatteredLuminance(rayWorldPosKm, lightStepSizeKm, rayDirection) + PassSrg::GetAmbientLightColor(heightFraction);

        // Энергосберегающее интегрирование по отрезку (Hillaire, Frostbite 2016).
        const float3 integScatt = (luminance - luminance * stepTransmittance) / eCoef;
        totalColor += totalTransmittance * integScatt;
        const float depthWeight = totalTransmittance * (1.0 - stepTransmittance);
        depthWeightedSumKm += depthWeight * (distanceToInnerSphereKm + sampleT);
        depthWeightSum += depthWeight;
        if (frontDepthKm < 0.0)
        {
            frontDepthKm = distanceToInnerSphereKm + sampleT;
        }
        totalTransmittance *= stepTransmittance;

        if (totalTransmittance <= 0.01)
        {
            break;
        }
        prevT = t;
        t = sampleT + stepSizeKm;
    }

    float totalAlpha = 1.00 - totalTransmittance;

    // Слой гасят на краю карты погоды: дальше узор шума повторяется.
    // До границы затухания дальние облака скрывает воздушная перспектива
    // растрового прохода. Длинный переход за один-три периода карты
    // не даёт ровной линии конца слоя у горизонта.
    const float fadeStartKm = PassSrg::m_weatherMapSizeKm * 1.0;
    const float fadeEndKm = PassSrg::m_weatherMapSizeKm * 3.0;
    const float fadeFraction = saturate((distanceToInnerSphereKm - fadeStartKm) / max(fadeEndKm - fadeStartKm, 0.001));
    totalAlpha = lerp(totalAlpha, 0.0, fadeFraction);
    totalColor = lerp(totalColor, float3(0.0, 0.0, 0.0), fadeFraction);

    result.m_color = float4(totalColor, totalAlpha);
    if (depthWeightSum > 0.0)
    {
        result.m_frontDepthKm = frontDepthKm;
        result.m_meanDepthKm = depthWeightedSumKm / depthWeightSum;
    }
    return result;

}


// Поток марширует один пиксель блока 2x2; положение пикселя в блоке
// меняется по кадрам. Остальные 15 пикселей восстанавливает проход
// CloudscapeReprojectionCS из истории.
[numthreads(8, 8, 1)]
void MainCS(uint3 thread_id: SV_DispatchThreadID)
{
    const uint2 blockLoc = thread_id.xy;
    uint2 traceDims;
    PassSrg::m_cloudTraceOut.GetDimensions(traceDims.x, traceDims.y);
    if ((blockLoc.x >= traceDims.x) || (blockLoc.y >= traceDims.y))
    {
        return;
    }

    uint2 texDims;
    PassSrg::m_cloudscapeOut[0].GetDimensions(texDims.x, texDims.y);
    const uint2 pixelLoc = min(blockLoc * CloudBlockSize + GetTracedOffsetInBlock(PassSrg::m_pixelIndex4x4), texDims - 1);

    const float2 pixelLocF = float2(pixelLoc);
    const float2 pixelUV = (pixelLocF + 0.5) / float2(texDims);
    PassSrg::m_cloudTraceOut[blockLoc] = PackCloudTrace(GetCloudColor(pixelUV, pixelLocF));
}
