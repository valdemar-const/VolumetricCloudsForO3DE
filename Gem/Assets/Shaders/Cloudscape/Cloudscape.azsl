#include <scenesrg_all.srgi>
#include <viewsrg_all.srgi>

#include <Atom/Features/PostProcessing/FullscreenVertex.azsli>
#include <Atom/Features/PostProcessing/FullscreenPixelInfo.azsli>
#include <Atom/Features/ColorManagement/TransformColor.azsli>
#include <Atom/Features/ScreenSpace/ScreenSpaceUtil.azsli>

#include "CloudscapeCommon.azsli"

ShaderResourceGroup PassSrg : SRG_PerPass
{
    // Takes value 0 or 1, and helps select the @m_cloudscapeTexture.
    uint m_cloudscapeTextureIndex;

    Texture2D<float2> m_depthStencilTexture;

    // We read from only one of these two textures every other frame.
    Texture2D<float4> m_cloudscapeTexture[2];

    Texture2D<uint4> m_cloudTrace;

    // 1, если объём m_skyVolumeLUT получен от гема SkyAtmosphere.
    uint m_aerialPerspectiveEnabled;

    // rgb: дымка до глубины среза, a: непрозрачность воздуха.
    // Срезы: глубина = (w^2 * 32) * 4 км (SkyAtmosphereCommon.azsli).
    Texture3D<float4> m_skyVolumeLUT;

    Sampler LinearSampler
    {
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
        AddressU = Clamp;
        AddressV = Clamp;
        AddressW = Clamp;
    };

    float4 GetCloudColor(int3 pixelLoc)
    {
        return m_cloudscapeTexture[m_cloudscapeTextureIndex].Load(pixelLoc);
    }
}

// Ширина перехода у передней границы облака: край облака у геометрии
// без перехода мерцает из-за глубины по блокам 2x2.
static const float OcclusionFadeKm = 0.3;

// Постоянные гема SkyAtmosphere: SKY_VOLUME_SLICE_COUNT, SKY_VOLUME_KM_PER_SLICE
// и множитель экспозиции неба в SkyRayMarching.azsl.
static const float SkyVolumeSliceCount = 32.0;
static const float SkyVolumeKmPerSlice = 4.0;
static const float SkyExposure = 20.0;

PSOutput MainPS(VSOutput IN)
{
    PSOutput OUT;

    const int3 pixelLoc = int3(IN.m_position.xy, 0);

    float4 cloudColor = PassSrg::GetCloudColor(pixelLoc);

    // Марш не обрезают геометрией; облако за геометрией гасят здесь
    // по передней глубине облака.
    uint2 traceDims;
    PassSrg::m_cloudTrace.GetDimensions(traceDims.x, traceDims.y);
    const int2 blockLoc = min(pixelLoc.xy >> CloudBlockShift, int2(traceDims) - 1);
    const CloudTraceSample trace = UnpackCloudTrace(PassSrg::m_cloudTrace.Load(int3(blockLoc, 0)));

    uint2 texDims;
    PassSrg::m_depthStencilTexture.GetDimensions(texDims.x, texDims.y);
    const float2 pixelUV = (float2(pixelLoc.xy) + 0.5) / float2(texDims);

    const float zDepth = PassSrg::m_depthStencilTexture.Load(pixelLoc).r;
    if (zDepth > 0.0)
    {
        const float3 pixelPosWS = WorldPositionFromDepthBuffer(pixelUV, zDepth).xyz;
        const float sceneDistanceKm = length(pixelPosWS - ViewSrg::m_worldPosition) * 0.001;
        cloudColor *= saturate((sceneDistanceKm - trace.m_frontDepthKm) / OcclusionFadeKm);
    }

    // Воздушная перспектива на средней глубине облака (Hillaire 2020):
    // воздух перед облаком гасит его свет и добавляет дымку.
    if (PassSrg::m_aerialPerspectiveEnabled != 0 && cloudColor.a > 0.0)
    {
        const float slice = min(trace.m_meanDepthKm / SkyVolumeKmPerSlice, SkyVolumeSliceCount);
        const float w = sqrt(slice / SkyVolumeSliceCount);
        float4 airPerspective = PassSrg::m_skyVolumeLUT.SampleLevel(PassSrg::LinearSampler, float3(pixelUV, w), 0);

        // Объём кончается на 128 км. Дальше воздух считают однородным:
        // пропускание степенно убывает с глубиной, дымка растёт вместе
        // с непрозрачностью.
        const float volumeDepthKm = SkyVolumeSliceCount * SkyVolumeKmPerSlice;
        if (trace.m_meanDepthKm > volumeDepthKm && airPerspective.a > 0.001)
        {
            const float opacity = 1.0 - pow(saturate(1.0 - airPerspective.a), trace.m_meanDepthKm / volumeDepthKm);
            airPerspective.rgb *= opacity / airPerspective.a;
            airPerspective.a = opacity;
        }
        cloudColor.rgb = cloudColor.rgb * (1.0 - airPerspective.a) + airPerspective.rgb * SkyExposure * cloudColor.a;
    }

    cloudColor.rgb = TransformColor(cloudColor.rgb, ColorSpaceId::LinearSRGB, ColorSpaceId::ACEScg);

    OUT.m_color = cloudColor;

    return OUT;
};
