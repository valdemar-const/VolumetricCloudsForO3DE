#include <scenesrg_all.srgi>
#include <viewsrg_all.srgi>

#include <Atom/RPI/Math.azsli>
#include <Atom/Features/ScreenSpace/ScreenSpaceUtil.azsli>

#include "CloudscapeCommon.azsli"

ShaderResourceGroup PassSrg : SRG_PerPass
{
    // Номер кадра 0..15: задаёт пиксель марша в блоке 2x2 и чётность
    // текстуры истории.
    uint m_pixelIndex4x4;

    // История: текстуру m_pixelIndex4x4 % 2 пишут, другую читают.
    RWTexture2D<float4> m_cloudscapeTexture[2];

    Texture2D<uint4> m_cloudTrace;

    Texture2D<float2> m_depthStencilTexture;
}

// Доля нового сэмпла для пикселя марша. Меньшее значение сильнее
// усредняет сдвиг старта луча, но дольше тянет шлейф при движении.
static const float TracedPixelBlend = 0.2;
// Доля интерполированного сэмпла для остальных пикселей блока.
static const float UpsampledPixelBlend = 0.1;
// Ширина границ истории в сигмах сэмплов соседних блоков.
static const float HistoryClipSigma = 1.25;

float4 LoadTraceColor(int2 traceLoc, int2 traceDims)
{
    const int2 loc = clamp(traceLoc, int2(0, 0), traceDims - 1);
    return UnpackCloudTrace(PassSrg::m_cloudTrace.Load(int3(loc, 0))).m_color;
}

float4 LoadHistory(uint index, int2 loc, int2 dims)
{
    return PassSrg::m_cloudscapeTexture[index][clamp(loc, int2(0, 0), dims - 1)];
}

// RW-текстуру нельзя читать сэмплером, поэтому фильтр собирают вручную.
float4 SampleHistoryBilinear(uint index, float2 pixelPos, int2 dims)
{
    const float2 p = pixelPos - 0.5;
    const int2 i = int2(floor(p));
    const float2 f = p - float2(i);
    const float4 c00 = LoadHistory(index, i, dims);
    const float4 c10 = LoadHistory(index, i + int2(1, 0), dims);
    const float4 c01 = LoadHistory(index, i + int2(0, 1), dims);
    const float4 c11 = LoadHistory(index, i + int2(1, 1), dims);
    return lerp(lerp(c00, c10, f.x), lerp(c01, c11, f.x), f.y);
}

[numthreads(8, 8, 1)]
void MainCS(uint3 thread_id: SV_DispatchThreadID)
{
    const int2 pixelLoc = int2(thread_id.xy);

    uint2 texDimsU;
    PassSrg::m_cloudscapeTexture[0].GetDimensions(texDimsU.x, texDimsU.y);
    const int2 texDims = int2(texDimsU);
    if ((pixelLoc.x >= texDims.x) || (pixelLoc.y >= texDims.y))
    {
        return;
    }

    uint2 traceDimsU;
    PassSrg::m_cloudTrace.GetDimensions(traceDimsU.x, traceDimsU.y);
    const int2 traceDims = int2(traceDimsU);

    const uint currentIndex = PassSrg::m_pixelIndex4x4 & 1;
    const uint previousIndex = 1 - currentIndex;

    const int2 tracedOffset = int2(GetTracedOffsetInBlock(PassSrg::m_pixelIndex4x4));
    const int2 blockLoc = min(pixelLoc >> CloudBlockShift, traceDims - 1);
    const bool isTracedPixel = all(pixelLoc == blockLoc * CloudBlockSize + tracedOffset);

    const CloudTraceSample center = UnpackCloudTrace(PassSrg::m_cloudTrace.Load(int3(blockLoc, 0)));

    // Границы значений истории: среднее +- 1.25 сигмы сэмплов этого кадра
    // в блоках 3x3 (Salvi 2016). Границы min/max расширяет любой шумный
    // сэмпл, и шум проходит в историю; границы по сигме уже.
    float4 moment1 = 0.0;
    float4 moment2 = 0.0;
    [unroll] for (int y = -1; y <= 1; ++y)
    {
        [unroll] for (int x = -1; x <= 1; ++x)
        {
            const float4 c = LoadTraceColor(blockLoc + int2(x, y), traceDims);
            moment1 += c;
            moment2 += c * c;
        }
    }
    moment1 /= 9.0;
    const float4 sigma = sqrt(max(moment2 / 9.0 - moment1 * moment1, 0.0));
    const float4 minColor = moment1 - HistoryClipSigma * sigma;
    const float4 maxColor = moment1 + HistoryClipSigma * sigma;

    // Интерполяция сэмплов этого кадра в точке пикселя: сэмпл блока
    // лежит в пикселе blockLoc * CloudBlockSize + tracedOffset.
    const float2 tracePos = (float2(pixelLoc - tracedOffset)) / float(CloudBlockSize);
    const int2 t0 = int2(floor(tracePos));
    const float2 tf = tracePos - float2(t0);
    const float4 upsampled = lerp(
        lerp(LoadTraceColor(t0, traceDims), LoadTraceColor(t0 + int2(1, 0), traceDims), tf.x),
        lerp(LoadTraceColor(t0 + int2(0, 1), traceDims), LoadTraceColor(t0 + int2(1, 1), traceDims), tf.x),
        tf.y);

    // Перенос истории: точка облака на средней глубине по пропусканию.
    // Без облака глубина 1000 км: перенос почти по одному направлению.
    const float2 pixelUV = (float2(pixelLoc) + 0.5) / float2(texDims);
    const float3 farPosWS = WorldPositionFromDepthBuffer(pixelUV, 0.0).xyz;
    const float3 rayDirection = normalize(farPosWS - ViewSrg::m_worldPosition);
    const float3 cloudPosWS = ViewSrg::m_worldPosition + rayDirection * (center.m_meanDepthKm * 1000.0);

    const float4 clipPosPrev = mul(ViewSrg::m_viewProjectionPrevMatrix, float4(cloudPosWS, 1.0));
    const float2 ndcPrev = clipPosPrev.xy / clipPosPrev.w;
    const float2 uvPrev = ndcPrev * float2(0.5, -0.5) + 0.5;
    const float2 pixelPosPrev = uvPrev * float2(texDims);

    bool isHistoryValid = (clipPosPrev.w > 0.0) &&
        all(pixelPosPrev >= 0.0) && all(pixelPosPrev < float2(texDims));

    float4 history = 0.0;
    if (isHistoryValid)
    {
        history = SampleHistoryBilinear(previousIndex, pixelPosPrev, texDims);
        // Текстура после создания содержит произвольные данные.
        isHistoryValid = all(isfinite(history));
    }

    float4 result;
    if (isTracedPixel)
    {
        result = isHistoryValid
            ? lerp(clamp(history, minColor, maxColor), center.m_color, TracedPixelBlend)
            : center.m_color;
    }
    else
    {
        result = isHistoryValid
            ? lerp(clamp(history, minColor, maxColor), upsampled, UpsampledPixelBlend)
            : upsampled;
    }

    PassSrg::m_cloudscapeTexture[currentIndex][pixelLoc] = result;
}
